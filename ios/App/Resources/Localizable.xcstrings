    "认证失败，请检查连接密钥和局域网访问设置。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证失败，请检查连接密钥和局域网访问设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Check keys and local network access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました。キーとローカルネットワーク設定を確認してください。"
          }
        }
      }
    },
    "SSH 认证失败，请检查用户名和凭据。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 认证失败，请检查用户名和凭据。"
