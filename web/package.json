{
  "name": "magpie-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "screenshots": "npm run build && playwright test",
    "demo:video": "npm run build && playwright test -c playwright.demo.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"worker/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,jsonc}\" README.md"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "@playwright/test": "^1.51.1",
    "@preact/preset-vite": "^2.10.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^5.0.5"
  }
}
